#!/bin/sh
# Crosshead host plugin hook launcher. Generated by scripts/host-plugins.mjs from
# src/runtime/host-hook-spec.ts; do not edit.
#
# Runs the hook entrypoint of the Crosshead runtime installed by
# `curl -fsSL https://crosshead.sh/install | bash`. It never downloads or
# installs code. Without a configured runtime it prints a setup notice on
# SessionStart and exits 0 so the session is never blocked.
host="$1"
event="$2"
case "$host" in
  claude-code)
    hook=crosshead-claude-code-hook
    config="${CLAUDE_CONFIG_DIR:-${CLAUDE_CODE_HOME:-$HOME/.claude}}/onlybots/claude-code-adapter.json"
    setup_notice='{"systemMessage":"Crosshead isn'"'"'t set up: run /crosshead:setup.","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"Crosshead isn'"'"'t set up: run /crosshead:setup."}}'
    update_notice='{"systemMessage":"The installed Crosshead runtime predates the Claude Code plugin: run /crosshead:setup to update it.","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"The installed Crosshead runtime predates the Claude Code plugin: run /crosshead:setup to update it."}}'
    ;;
  codex)
    hook=crosshead-codex-hook
    config="${CODEX_HOME:-$HOME/.codex}/onlybots/codex-adapter.json"
    setup_notice='{"systemMessage":"Crosshead isn'"'"'t set up: ask Codex to use the crosshead setup skill ($crosshead:setup).","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"Crosshead isn'"'"'t set up: ask Codex to use the crosshead setup skill ($crosshead:setup)."}}'
    update_notice='{"systemMessage":"The installed Crosshead runtime predates the Codex plugin: ask Codex to use the crosshead setup skill ($crosshead:setup) to update it.","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"The installed Crosshead runtime predates the Codex plugin: ask Codex to use the crosshead setup skill ($crosshead:setup) to update it."}}'
    ;;
  *) exit 0 ;;
esac
home="${CROSSHEAD_HOME:-${CROSSHEAD_RUNTIME_HOME:-${ONLYBOTS_HOME:-${ONLYBOTS_RUNTIME_HOME:-}}}}"
if [ -z "$home" ]; then
  if [ ! -e "$HOME/.crosshead" ] && [ -d "$HOME/.onlybots" ]; then home="$HOME/.onlybots"; else home="$HOME/.crosshead"; fi
fi
wrapper="$home/bin/$hook"
if [ -x "$wrapper" ] && [ -f "$config" ] && grep -q '"hookMode"' "$config" 2>/dev/null; then
  exec "$wrapper" "$event" --home "$home" --via plugin
fi
cat > /dev/null 2>&1 || true
if [ "$event" = SessionStart ]; then
  if [ -x "$wrapper" ] && [ -f "$config" ]; then
    printf '%s\n' "$update_notice"
  else
    printf '%s\n' "$setup_notice"
  fi
fi
exit 0
